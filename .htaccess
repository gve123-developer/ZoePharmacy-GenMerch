<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Allow direct access to PHP API and includes
    RewriteRule ^(api|includes) - [L]

    # 2. Prevent infinite loops: if we are already serving from /dist/, stop rewriting
    RewriteCond %{REQUEST_URI} ^/dist/
    RewriteRule ^ - [L]

    # 3. If the requested file exists in /dist, serve it from /dist (e.g. /assets/style.css -> /dist/assets/style.css)
    RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f
    RewriteRule ^(.*)$ dist/$1 [L]

    # 4. Otherwise, route all remaining requests (like the root / or /dashboard) to dist/index.html for React Router
    RewriteRule ^(.*)$ dist/index.html [L]
</IfModule>

# Enable Gzip Compression for text, js, css, and json
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/xml image/svg+xml font/ttf font/woff font/woff2
</IfModule>

# Enable Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # Static assets (Vite hashed bundles and fonts) - 1 Year Cache
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Cache Vite hashed assets immutably
    <FilesMatch "\.(js|css|ttf|woff|woff2|jpg|jpeg|png|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Never cache the HTML shell so users instantly get new updates upon deploy
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>
